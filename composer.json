{
    "name": "silvershop/brands",
    "description": "Native product brands / manufacturers for SilverShop: a Brand model, product-to-brand link, and a sales-by-brand report.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "brand", "manufacturer"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-brands/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/reports": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "silverstripe/sqlite3": "^4",
        "silvershop/search": "dev-main"
    },
    "suggest": {
        "silvershop/search": "Adds a brand facet to the storefront product search"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RVXD/silvershop-search.git"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Brands\\": "src/",
            "SilverShop\\Brands\\Tests\\": "tests/unit/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
